# TrafficMind Agent 环境变量配置
# 复制此文件为 .env 并填入真实值

# DeepSeek API 配置
# 不配置也可以运行，系统会自动降级使用本地模板
DEEPSEEK_API_KEY=your_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 消息推送配置（可选）----------

# 企业微信机器人 Webhook
# 获取方式：企业微信群 → 群机器人 → 复制 Webhook 地址
WECHAT_WEBHOOK_URL=

# 钉钉机器人 Webhook
# 获取方式：钉钉群 → 群设置 → 智能群助手 → 添加机器人
DINGTALK_WEBHOOK_URL=

# 邮件 SMTP（用于高风险事件邮件告警）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# 触发推送的最低风险等级（高风险 / 重大风险）
HIGH_RISK_THRESHOLD=高风险

# ---------- Runtime Operations / Observability (Phase 21.4) ----------

# 轻量运维扫描周期与告警阈值（秒）
OPERATIONS_SCAN_INTERVAL=30
UNKNOWN_ALERT_AFTER=900
WORKFLOW_STUCK_AFTER=900
APPROVAL_ATTENTION_AFTER=900
APPROVAL_OVERDUE_AFTER=3600

# 同一 Action 连续失败到达此次数后生成运维告警
ACTION_REPEATED_FAILURE_THRESHOLD=3

# ---------- Memory V2 配置 (Phase 10) ----------

# 存储后端: sqlite | postgres (Phase 11 预留)
MEMORY_STORAGE_BACKEND=sqlite

# PostgreSQL 连接串（Phase 11 启用时填写）
# 格式: postgresql://user:password@host:port/dbname
MEMORY_DATABASE_URL=
